# Meta / Instagram Graph API credentials.
# Copy this file to .env and fill in real values. Never commit .env.
#
# Where to get each one — developers.facebook.com:
#   META_APP_ID              Meta App -> Settings -> Basic
#   META_APP_SECRET          Same page
#   META_PAGE_ACCESS_TOKEN   Graph API Explorer -> generate token (Page token, long-lived)
#   INSTAGRAM_ACCOUNT_ID     Graph API Explorer -> GET /<page-id>?fields=instagram_business_account
#   FACEBOOK_PAGE_ID         Same query as above

META_APP_ID=xxxxxxxxxxxxx
META_APP_SECRET=xxxxxxxxxxxxx
META_PAGE_ACCESS_TOKEN=xxxxxxxxxxxxx
INSTAGRAM_ACCOUNT_ID=xxxxxxxxxxxxx
FACEBOOK_PAGE_ID=xxxxxxxxxxxxx
